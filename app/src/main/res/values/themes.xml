<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BluetoothKeyboard" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    
    <!-- Custom Button Style -->
    <style name="ControlButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">16dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="elevation">4dp</item>
        <item name="android:minHeight">120dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    
    <!-- Primary Button Style -->
    <style name="PrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">16dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="elevation">6dp</item>
        <item name="android:minHeight">64dp</item>
    </style>
    
    <!-- Status Card Style -->
    <style name="StatusCard">
        <item name="android:background">@drawable/status_card_background</item>
        <item name="android:padding">20dp</item>
        <item name="android:layout_margin">16dp</item>
    </style>
</resources>

